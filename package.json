{
  "name": "exe-react-node-demo",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.3.3",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "cd apps/web && bun run dev",
    "build": "cd apps/web && bun run build",
    "start": "cd apps/web && bun run start",
    "check": "bun run check:workspace && bun run biome:check",
    "check:workspace": "cd apps/web && bun run check",
    "biome:check": "biome check .",
    "lint": "biome lint .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "typescript": "^5.9.3"
  }
}
