{
  "name": "exe-react-node-demo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "NODE_ENV=development node --watch server/index.js",
    "dev:client": "vite --host 0.0.0.0 --port 5173 client",
    "build": "vite build client --outDir ../dist/public --emptyOutDir",
    "start": "NODE_ENV=production node server/index.js",
    "check": "npm run build && node --check server/index.js"
  },
  "dependencies": {
    "@vitejs/plugin-react": "latest",
    "vite": "latest",
    "typescript": "latest",
    "react": "latest",
    "react-dom": "latest",
    "express": "latest",
    "morgan": "latest"
  },
  "devDependencies": {
    "concurrently": "latest"
  },
  "engines": {
    "node": ">=20"
  }
}
